# EQUENCY — Phase 1 (Intelligence Core). Copy to .env and fill. Never commit .env.
#
# SEC EDGAR needs NO API key — only a descriptive User-Agent with a contact email
# (SEC fair-access policy). This is the one always-LIVE, always-free Tier-1 source.
SEC_USER_AGENT="EQUENCY research bot (email:research@equency.com)"
SEC_EDGAR_API_KEY=            # unused by SEC; kept for compatibility, leave blank

# Finnhub — free tier gives /quote (live price) + /company-news. IPO calendar is PREMIUM
# (so IPO detection uses SEC EDGAR full-text search for 424B4 instead). https://finnhub.io/register
FINNHUB_API_KEY=

# Gemini (Google AI Studio, free tier) — the Reasoning Engine. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Alpaca (optional, for richer price history / options later). Needs BOTH.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Vercel Cron auth for /api/cron/warm (any random string; Vercel sends it as a Bearer token)
CRON_SECRET=

# Optional override of the $EQUENCY contract address shown on the landing page (default is in src/lib/site.ts)
# NEXT_PUBLIC_TOKEN_CA=
