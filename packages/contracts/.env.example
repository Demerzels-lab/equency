# EQUENCY contracts — copy to .env (gitignored). Never commit real keys.

# RPCs (Alchemy keeps Robinhood Chain reachable; public RPCs are often down).
RH_RPC_TESTNET=https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
RH_RPC_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer — needed ONLY to broadcast. Fund it with ETH on the target chain first
# (testnet needs ~0.0002 ETH per the dry-run estimate). Never print or commit this.
DEPLOYER_PRIVATE_KEY=
